# ---------------------------------------------------------------------------
# Free LLM gateway (/v1) — copy to .env for local dev, or paste into your host.
# Providers come from https://github.com/mnfst/awesome-free-llm-apis
# Only set the keys you actually have; the rest stay inactive.
# ---------------------------------------------------------------------------

# The one secret your Android app holds. Paste it as the "API key" in the app.
# Generate something long:  openssl rand -hex 32
GATEWAY_TOKEN=

# --- provider keys (any combination; all have free tiers) -------------------
GEMINI_API_KEY=        # https://aistudio.google.com/app/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai/
LLM7_API_KEY=          # https://token.llm7.io/   (optional, keyless works)
OVHCLOUD_API_KEY=      # optional, keyless works

# --- behaviour -------------------------------------------------------------
# Fallback order. Providers without a key are skipped automatically.
PROVIDER_ORDER=gemini,groq,openrouter,ovhcloud,llm7
# Set to 1 to never use the anonymous providers (OVHcloud, LLM7).
DISABLE_KEYLESS=0
# How long a provider that returned 429/5xx is skipped before being retried.
PROVIDER_COOLDOWN_MS=45000
# Give up on the whole fallback chain after this long.
FALLBACK_DEADLINE_MS=150000

# --- optional: any other OpenAI-compatible API ----------------------------
# Shows up in the chain as provider id "custom".
# CUSTOM_BASE_URL=https://api.example.com/v1
# CUSTOM_API_KEY=sk-...
# CUSTOM_MODEL=some-model
# Or define a brand-new provider without code:
# MYPROXY_BASE_URL=https://proxy.example.com/v1
# MYPROXY_API_KEY=sk-...
# MYPROXY_MODEL=llama-3.3-70b
# MYPROXY_LABEL=My proxy
# ...then put "myproxy" in PROVIDER_ORDER.

# --- existing app config ----------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
